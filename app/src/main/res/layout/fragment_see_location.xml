<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/liquid"
        tools:context=".fragment.SeeLocationFragment">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarLocation"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/charcoal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/back_button"
            app:title="@string/all_location"
            app:titleTextColor="@android:color/white" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/locationsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:padding="5dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintTop_toBottomOf="@id/toolbarLocation"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/item_destination" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
